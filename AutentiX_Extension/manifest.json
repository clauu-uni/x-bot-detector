{
  "manifest_version": 3,
  "name": "AutentiX - Detector de Bots",
  "version": "1.0",
  "description": "Analiza perfiles de X (Twitter) para detectar tráfico sintético.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analizar este perfil",
    "default_icon": {
      "128": "icon.png"
    }
  }
}
